#!/usr/bin/env bash
set -euo pipefail

# Heavy `go test` fan-out runs here, at push time, instead of on every commit
# (#3628). pre-commit previously invoked `make test-fast-parallel` on every
# commit. Its outer shard fan-out can compile ~2.8 GiB test binaries per job,
# so the canonical runner now derives concurrency from both CPU and available
# memory while preserving an explicit LOCAL_TEST_JOBS override. Running the
# suite at push time also fires it only when Go sources actually change.
#
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref
# on stdin (see githooks(5)).

zero="0000000000000000000000000000000000000000"

repo_root="$(git rev-parse --show-toplevel)"
remote="${1:-origin}"

# git opens the SSH transport for this push BEFORE running this hook, then
# reuses that same connection for the pack write after the hook exits. A gate
# that runs long enough leaves the socket idle until GitHub's server closes it,
# so a fully green gate still SIGPIPEs (exit 141) with the ref never moving
# (ga-7i1o). This can't save the push currently running this hook -- the
# transport is already open -- but it heals core.sshCommand for the *next*
# push in this worktree, including retries of this one. `make setup` is the
# primary point of coverage; this is defense-in-depth against .git/config
# erosion (ga-fxhk) and worktrees that skipped setup. Only fills in a missing
# keepalive -- never clobbers an operator's own core.sshCommand customization.
case "$(git config --get core.sshCommand || true)" in
  *ServerAliveInterval*) ;;
  *) git config core.sshCommand 'ssh -o ServerAliveInterval=20 -o ServerAliveCountMax=180 -o TCPKeepAlive=yes' ;;
esac

# Integration branches consulted when a pushed branch does not exist on the
# remote yet. Space-separated; override for repos using other names.
push_gate_base_branches="${PUSH_GATE_BASE_BRANCHES:-develop main master}"

# Refs a not-yet-pushed branch may have forked from, most specific first: its
# own tracked upstream, the remote's default branch, then the conventional
# integration branches this remote actually carries.
base_candidate_refs() {
  local ref="$1" upstream head_ref name
  upstream="$(git for-each-ref --format='%(upstream)' "$ref" 2>/dev/null || true)"
  if [ -n "$upstream" ]; then
    printf '%s\n' "$upstream"
  fi
  head_ref="$(git symbolic-ref --quiet "refs/remotes/$remote/HEAD" 2>/dev/null || true)"
  if [ -n "$head_ref" ]; then
    printf '%s\n' "$head_ref"
  fi
  for name in $push_gate_base_branches; do
    if git show-ref --verify --quiet "refs/remotes/$remote/$name"; then
      printf '%s\n' "refs/remotes/$remote/$name"
    fi
  done
  return 0
}

# Newest commit the branch shares with any candidate base — its fork point.
# Diffing from there covers exactly what the branch adds: everything at or
# below it is already on the remote and was gated when it landed. Prints
# nothing when no candidate shares history, so the caller can fall back to the
# full suite rather than assume the branch is clean.
new_branch_base() {
  local ref="$1" tip="$2" candidate base best=""
  for candidate in $(base_candidate_refs "$ref"); do
    base="$(git merge-base "$candidate" "$tip" 2>/dev/null || true)"
    if [ -z "$base" ]; then
      continue
    fi
    if [ -z "$best" ] || git merge-base --is-ancestor "$best" "$base" 2>/dev/null; then
      best="$base"
    fi
  done
  printf '%s' "$best"
  return 0
}

# The ref list arrives once on stdin but two consumers need it: the beads chain
# and the Go-change scan below. Buffer it and replay it to each.
refs_stdin="$(cat)"

# `$(cat)` strips trailing newlines, so re-terminate the final line: `read`
# returns non-zero on an unterminated line and the scan would drop it. The
# emptiness guard keeps `printf` from manufacturing a blank ref line.
replay_refs() {
  [ -n "$refs_stdin" ] && printf '%s\n' "$refs_stdin"
  return 0
}

# .githooks owns core.hooksPath, so this call is the only thing keeping beads'
# own pre-push hook alive (ga-z1f5).
"$repo_root/.githooks/lib/beads-chain.sh" pre-push "$@" < <(replay_refs)

go_changed=0
any_non_deletion=0
while read -r local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion — nothing to test, nothing to guard.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  any_non_deletion=1
  # Branch is new on the remote. A zero remote sha means "the remote has no
  # copy of this branch", not "this branch has no base": it still forked from
  # something the remote already carries, so diff from that fork point instead
  # of testing everything (ga-vlhp). Every polecat's first push lands here, and
  # the full suite outlives the per-tool timeout that kills the push mid-hook —
  # stranding the branch off origin while its bead still reads in_progress.
  if [ "$remote_sha" = "$zero" ]; then
    remote_sha="$(new_branch_base "$local_ref" "$local_sha")"
    if [ -z "$remote_sha" ]; then
      go_changed=1
      continue
    fi
  fi
  if git diff --name-only "$remote_sha" "$local_sha" -- '*.go' 2>/dev/null | grep -q .; then
    go_changed=1
  fi
done < <(replay_refs)

# Bead ownership/staleness guard (ga-fip9ps.1): re-checks bd claim state
# immediately before this push leaves the machine, once per invocation
# (not per ref) regardless of whether Go sources changed. A mayor ruling
# (reassign/close/hold/reroute) that landed after this push was queued
# must not be allowed to clobber a branch another agent has since taken
# over. Bypass: `git push --no-verify`.
if [ "$any_non_deletion" -eq 1 ]; then
  # shellcheck source=../scripts/push-ownership-guard.sh disable=SC1091
  . "$repo_root/scripts/push-ownership-guard.sh"
  if ! assert_bead_still_claimed; then
    exit 1
  fi
fi

if [ "$go_changed" -eq 0 ]; then
  exit 0
fi

# Push-gate dedup (ga-4rr4). On a refinery merge this hook is the *second* gate
# over one tree: the run-tests step already ran the identical fast suite over
# the identical merged content, and is now pushing that content past this hook.
# Measured at ~12min followed by ~16min on one branch, against a queue of them.
#
# Neither gate can be deleted. The refinery needs a verdict *before* pushing,
# because that is what distinguishes "this branch is bad" (reject to the pool)
# from "the push flaked" (retry) — a distinction this rig leans on. So the
# second gate reads the first one's verdict rather than re-deriving it. The
# marker names one exact tree hash, only a clean worktree has such a name, and
# it expires; scripts/lib/verified-tree.sh documents why each of those is
# load-bearing. It also covers the retry case directly: a push reaped mid-hook
# no longer costs a second full suite on the way back through.
#
# Deliberately placed below the beads chain and the ownership guard so only the
# duplicated *suite* is skipped. A push superseded by a mayor ruling must still
# be stopped, however green its tree.
# shellcheck source=../scripts/lib/verified-tree.sh disable=SC1091
. "$repo_root/scripts/lib/verified-tree.sh"
if gc_verified_tree_is_fresh fast; then
  echo "pre-push: this exact tree already passed the fast suite; skipping the duplicate run."
  echo "pre-push: force the real run with 'PUSH_GATE_IGNORE_VERIFIED=1 git push ...'."
  exit 0
fi

# The Makefile and direct sharded runner share scripts/test-local-job-count as
# their default policy. Do not shadow it here; an explicit override still wins.
#
# Run the gate as a child instead of `exec`ing it. This shell has to outlive
# the suite to tell "the gate was killed" apart from "the gate failed": under
# `exec` the hook process *is* make, so a signal death reaches git as a
# generic hook failure and all the pushing agent sees is `make: *** wait: No
# child processes` over an empty FAIL list — which reads as a flaky test and
# gets retried straight into whatever did the killing (ga-8qmy). The cost is
# one extra shell process for the length of the gate.
#
# This covers the cases where the suite dies but this hook survives. A kill
# aimed at the whole process group takes this shell with it, and nothing
# inside the tree can report that; running the gate in its own session is
# tracked separately.
# shellcheck source=../scripts/lib/signal-status.sh disable=SC1091
. "$repo_root/scripts/lib/signal-status.sh"

gate_status=0
make test-fast-parallel || gate_status=$?

if [ "$gate_status" -eq 0 ]; then
  exit 0
fi

if gc_status_is_signal_death "$gate_status"; then
  cat >&2 <<EOF
pre-push: PUSH GATE ABORTED — the push-time suite was $(gc_signal_status_describe "$gate_status").
pre-push: This is NOT a test failure. The suite was terminated before any test
pre-push: reported a verdict, so this tree is neither verified nor refuted and
pre-push: an empty FAIL list here means nothing.
pre-push: Nothing was pushed.
pre-push:
pre-push: Do not simply re-push. A gate reaped once is usually reaped the same
pre-push: way again; find what terminated it first. See the "Shared-Host Test
pre-push: Conventions" section of TESTING.md.
EOF
fi

exit "$gate_status"
