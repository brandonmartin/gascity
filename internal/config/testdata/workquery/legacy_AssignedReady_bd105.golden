sh -c 'for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; legacy=""; case "$id" in *control-dispatcher) legacy="${id%control-dispatcher}workflow-control";; esac; for cand in "$id" "$legacy"; do [ -z "$cand" ] && continue; r=$(bd ready --include-ephemeral --assignee="$cand" --json --limit=1 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; done; if bd_probe_err=$(bd list --limit=1 --json 2>&1 >/dev/null); then printf "[]"; else printf "hook check failed: refusing to report an empty hook because bd is broken: %s\n" "$bd_probe_err" >&2; exit 97; fi'