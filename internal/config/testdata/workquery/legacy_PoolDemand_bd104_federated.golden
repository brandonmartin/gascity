sh -c 'target="$1"; ready_json=$(gc ready --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "human" --json --limit 0) || exit $?; if [ -n "$ready_json" ] && [ "$ready_json" != "[]" ]; then gc_unheld=$(printf "%s" "$ready_json" | jq -c '\''if type == "array" and any(.[]; any((.labels // [])[]; (if type == "string" then (ascii_downcase | startswith("hold:")) else false end))) then [.[] | select((any((.labels // [])[]; (if type == "string" then (ascii_downcase | startswith("hold:")) else false end))) | not)] else empty end'\''); [ -n "$gc_unheld" ] && ready_json="$gc_unheld"; fi; legacy_candidates=$(gc ready --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "human" --json --sort oldest --limit 0) || exit $?; legacy_json=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select(((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.workflow_expanded"] // "") != "true")) | select(([ (.labels // [])[] | select((if type == "string" then (ascii_downcase | startswith("hold:")) else false end)) ] | length) == 0)]'\'') || exit $?; legacy_ephemeral_json=$({ bd query --json '\''ephemeral=true AND status=open'\'' --limit=0 | jq --arg target "$target" '\''[.[] | select((.assignee // "") == "") | select(((.metadata["gc.routed_to"] // "") == $target) or (((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.run_target"] // "") == $target) and ((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.workflow_expanded"] // "") != "true"))) | select(((.issue_type // .type // "") != "epic")) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external" or . == "human") ] | length) == 0) | select(([ (.labels // [])[] | select((if type == "string" then (ascii_downcase | startswith("hold:")) else false end)) ] | length) == 0) | select(((.dependency_count // 0) == 0))] | sort_by(.created_at // "", .id // "")'\''; } || printf "[]"); printf "%s\n%s\n%s\n" "$ready_json" "$legacy_json" "$legacy_ephemeral_json" | jq -s "(add // []) | unique_by(.id) | length"' -- rig/control-dispatcher