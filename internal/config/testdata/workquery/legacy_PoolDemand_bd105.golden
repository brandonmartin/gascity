sh -c 'target="$1"; ready_json=$(bd ready --include-ephemeral --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "human" --json --limit 0) || exit $?; if [ -n "$ready_json" ] && [ "$ready_json" != "[]" ]; then gc_unheld=$(printf "%s" "$ready_json" | jq -c '\''if type == "array" and any(.[]; any((.labels // [])[]; (if type == "string" then (ascii_downcase | startswith("hold:")) else false end))) then [.[] | select((any((.labels // [])[]; (if type == "string" then (ascii_downcase | startswith("hold:")) else false end))) | not)] else empty end'\''); [ -n "$gc_unheld" ] && ready_json="$gc_unheld"; fi; legacy_candidates=$(bd ready --include-ephemeral --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "human" --json --sort oldest --limit 0) || exit $?; legacy_json=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select(((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.workflow_expanded"] // "") != "true")) | select(([ (.labels // [])[] | select((if type == "string" then (ascii_downcase | startswith("hold:")) else false end)) ] | length) == 0)]'\'') || exit $?; legacy_ephemeral_json="[]"; printf "%s\n%s\n%s\n" "$ready_json" "$legacy_json" "$legacy_ephemeral_json" | jq -s '\''(add // []) | unique_by(.id) | map(select((((.metadata["gc.kind"] // "") | gsub("^\\s+|\\s+$"; "")) != "workflow" or ((.metadata["gc.workflow_expanded"] // "") | gsub("^\\s+|\\s+$"; "")) != "true") and ((.metadata["gc.kind"] // "") | gsub("^\\s+|\\s+$"; "")) != "scope" and ((.metadata["gc.kind"] // "") | gsub("^\\s+|\\s+$"; "")) != "spec")) | length'\''' -- rig/control-dispatcher