sh -c 'for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; r=$(gc ready --include-ephemeral --assignee="$id" --json --limit=1) || exit $?; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; if bd_probe_err=$(bd list --limit=1 --json 2>&1 >/dev/null); then printf "[]"; else printf "hook check failed: refusing to report an empty hook because bd is broken: %s\n" "$bd_probe_err" >&2; exit 97; fi'