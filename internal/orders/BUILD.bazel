load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "orders",
    srcs = [
        "cron.go",
        "discovery.go",
        "env.go",
        "exec_outcome.go",
        "filenames.go",
        "filter.go",
        "order.go",
        "override.go",
        "runtime_helpers.go",
        "scanner.go",
        "store.go",
        "store_reads.go",
        "trigger_exec_unix.go",
        "trigger_exec_windows.go",
        "triggers.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/orders",
    visibility = ["//:__subpackages__"],
    deps = ["@com_github_burntsushi_toml//:toml"],
)

go_test(
    name = "orders_test",
    srcs = [
        "discovery_test.go",
        "env_test.go",
        "exec_outcome_test.go",
        "filenames_test.go",
        "filter_test.go",
        "order_test.go",
        "override_test.go",
        "runtime_helpers_test.go",
        "scanner_test.go",
        "store_reads_bounded_test.go",
        "store_reads_test.go",
        "store_test.go",
        "testenv_import_test.go",
        "trigger_exec_unix_test.go",
        "triggers_test.go",
        "webhook_trigger_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//:go.mod",
        "//examples/bd/dolt:pack_files",
        "//internal/bootstrap/packs/core:pack_files",
    ],
    embed = [":orders"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
